{
  "name": "harlani-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "validate:nibo:live": "node --env-file=.env.local scripts/validate-nibo/fetch-nibo-live.mjs",
    "validate:nibo:app": "node scripts/validate-nibo/fetch-app-proxy.mjs",
    "validate:nibo:compare": "node scripts/validate-nibo/compare.mjs",
    "validate:nibo": "npm run validate:nibo:live && npm run validate:nibo:app && npm run validate:nibo:compare"
  },
  "dependencies": {
    "@upstash/redis": "^1.38.2",
    "lucide-react": "^1.34.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "jsdom": "^29.1.1",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
